{
  "name": "algo-sync-vscode-extension",
  "displayName": "Algo Sync Workspace",
  "description": "Workspace-scoped synchronization with supported online judge editors.",
  "version": "1.0.4",
  "publisher": "local-algo-sync",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:.algo-sync.json"
  ],
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "shd101wyy.markdown-preview-enhanced"
  ],
  "contributes": {
    "commands": [
      {
        "command": "algoSync.showStatus",
        "title": "Algo Sync: Show Status"
      },
      {
        "command": "algoSync.showLog",
        "title": "Algo Sync: Show Log"
      },
      {
        "command": "algoSync.showStatement",
        "title": "Algo Sync: Show Problem Statement"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-vscode.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package:vsix": "npm run build && vsce package --no-dependencies --allow-missing-repository --out ../../dist/algo-sync-vscode.vsix"
  },
  "dependencies": {
    "@algo-sync/shared": "1.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.18.0"
  }
}
